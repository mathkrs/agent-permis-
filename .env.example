# Copie ce fichier en .env (jamais commité, voir .gitignore) et remplis
# les vraies valeurs. Ne jamais mettre ces valeurs dans un fichier suivi
# par git.

# --- Identifiants de connexion au portail Tradispo (OCV Genève) ---
FABER_NIP=
FABER_BIRTHDATE=

# --- Fenêtre de dates acceptables (AAAA-MM-JJ, bornes incluses) ---
DATE_RANGE_START=2026-07-15
DATE_RANGE_END=2026-08-02

# --- Notification par email (SMTP) ---
# Exemple avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=tonadresse@gmail.com, SMTP_PASS=<mot de passe d'application>
# (PAS ton mot de passe Gmail normal — Google bloque l'auth SMTP basique.
# Génère un "mot de passe d'application" sur myaccount.google.com/apppasswords,
# nécessite la validation en 2 étapes activée sur le compte).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# --- Notification push mobile (ntfy.sh, gratuit, sans compte) ---
# Choisis un nom de topic unique et garde-le secret (quiconque le connaît
# peut voir tes notifications). Puis installe l'app ntfy (iOS/Android) et
# abonne-toi à ce même topic.
NTFY_TOPIC=
